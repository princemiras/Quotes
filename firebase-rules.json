{
  "rules": {
    ".read": false,
    ".write": false,

    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['uid', 'name']) && $code.matches(/^[A-Z0-9]{4,8}$/)",
        "uid":  { ".validate": "newData.isString()" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "$other": { ".validate": false }
      }
    },

    "inbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$mid": {
          ".write": "auth != null && (auth.uid === $uid || (!data.exists() && newData.child('fromUid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['fromUid', 'fromCode', 'fromName', 'text', 'ts']) && newData.child('ts').val() === now && root.child('codes').child(newData.child('fromCode').val()).child('uid').val() === auth.uid",
          "fromUid":  { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "fromCode": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{4,8}$/)" },
          "fromName": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "text":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
          "ts":       { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
